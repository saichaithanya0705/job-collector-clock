{
  "name": "job-collector-clock",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/2 * * * *"] },
  "durable_objects": { "bindings": [{ "name": "CLOCK", "class_name": "CollectorClock" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollectorClock"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
